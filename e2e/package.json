{
  "name": "finance-assistant-web-e2e",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "e2e": "bddgen test && playwright test",
    "e2e:ui": "bddgen test && playwright test --ui",
    "e2e:headed": "bddgen test && playwright test --headed",
    "e2e:gen": "bddgen test --verbose",
    "e2e:playwright": "playwright test --project=smoke",
    "browsers:install": "playwright install chromium",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "playwright-bdd": "^9.0.0",
    "typescript": "~6.0.2",
    "@types/node": "^24.12.3"
  }
}
